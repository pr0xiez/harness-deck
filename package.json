{
  "name": "harness-deck",
  "version": "0.1.0",
  "description": "A desktop workspace for running coding agent CLIs (Claude Code, Copilot CLI, Codex CLI) side by side",
  "repository": "github:pr0xiez/harness-deck",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "icons": "electron scripts/make-icons.mjs",
    "smoke": "npm run build && electron . --smoke",
    "package": "npm run build && electron-builder",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "jsonc-parser": "^3.3.1",
    "toml-eslint-parser": "^1.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.2.0": true
  }
}
